# Salin file ini jadi .env.local lalu isi API key kamu.
# Pilih default: gemini, openai, anthropic, openrouter, 9router, groq,
# deepseek, mistral, together, ollama, lmstudio, custom.
# Kosong = provider pertama yang sudah dikonfigurasi. Bisa diganti di UI.
AI_PROVIDER=
# API key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai (harus support input gambar untuk fitur manga).
# Contoh: gemini-3.8-flash (default), gemini-3.5-flash-lite (lebih hemat), gemini-4-hydrogen
GEMINI_MODEL=gemini-3.8-flash

# Opsional: MINIMAL / LOW / MEDIUM / HIGH. Kosongkan untuk default model.
# LOW biasanya cukup untuk terjemahan dan bikin respons lebih cepat.
GEMINI_THINKING_LEVEL=

# Isi hanya provider yang dipakai. Semua key hanya dibaca server.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# 9Router: jalankan router dan hubungkan provider di dashboard terlebih dahulu.
# Aktifkan baris BASE_URL atau set AI_PROVIDER=9router.
# NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
# Isi ID model/combo dari dashboard, atau pilih lewat "Muat daftar model" di UI.
NINEROUTER_MODEL=

# Lokal (opsional, aktifkan hanya yang digunakan):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5vl:7b
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=

# Endpoint custom OpenAI-compatible (base URL termasuk /v1, bukan /chat/completions):
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Untuk setiap prefix di atas, boleh set <PREFIX>_MODEL / <PREFIX>_BASE_URL.
# Contoh: OPENAI_MODEL=gpt-4.1-mini
# Output manga OpenAI-compatible: <PREFIX>_JSON_MODE=schema | object | none.
# Default 9Router/custom: none (JSON schema tetap dikirim dalam prompt).
# NINEROUTER_JSON_MODE=none
# localhost mengacu ke mesin SERVER AutoTL, bukan browser.
